+#ifdef __WXOSX__
+#include <wx/bmpbndl.h>
+inline wxBitmapBundle wxOSXMakeBundleFromImage(NSImage *img)
+{
+    if (img)
+    {
+        CGImageRef cgImage = [img CGImageForProposedRect:nil context:nil hints:nil];
+        if (cgImage)
+            return wxBitmapBundle::FromBitmap(wxBitmap(cgImage));
+    }
+    return wxBitmapBundle();
+}
