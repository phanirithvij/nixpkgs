{
  pkgs,
  evalSystem,
}:
let
  inherit (pkgs) lib;

  node = evalSystem {
    system.stateVersion = "26.11";
    programs.whois = {
      enable = true;
      settings = [
        {
          pattern = "\\.dn42$";
          server = "whois.dn42";
        }
        {
          pattern = "\\-DN42$";
          server = "whois.dn42";
        }
        {
          pattern = "^as424242[0-9]{4}$";
          server = "whois.dn42";
        }
      ];
    };
  };

  expected = pkgs.writeText "whois.conf" ''
    # Generated by NixOS.
    # See whois.conf(5) for the file format.
    \.dn42$ whois.dn42
    \-DN42$ whois.dn42
    ^as424242[0-9]{4}$ whois.dn42
  '';
in
pkgs.runCommand "whois-test"
  {
    nativeBuildInputs = [ pkgs.whois ];
    meta.maintainers = with lib.maintainers; [ Cryolitia ];
  }
  ''
    command -v whois
    diff -u "${node.config.environment.etc."whois.conf".source}" "${expected}"
    touch $out
  ''
